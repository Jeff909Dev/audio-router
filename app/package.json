{
  "name": "audio-router",
  "productName": "Audio Router",
  "private": true,
  "version": "0.1.0",
  "description": "Virtual loopback audio driver for macOS, with a control app",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wait-on": "^9.5.1"
  }
}
